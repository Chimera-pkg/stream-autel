{
  "name": "stream-autel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "ts-node-dev --respawn --transpile-only server.ts",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "build": "tsc -p .",
    "start:server": "node dist/server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-media-server": "^2.3.6",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.4.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
